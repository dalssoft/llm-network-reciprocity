# Only needed to run new simulations. The analysis scripts work on the
# saved data and need no keys.

# --- Read by the simulation code -------------------------------------------
# The code talks to an OpenAI-compatible endpoint. We used a local LiteLLM
# proxy (see litellm_config.yaml and the README).
OPENAI_BASE_URL=http://localhost:4000/v1
OPENAI_API_KEY=any-string-or-your-litellm-master-key

# --- Read by the LiteLLM proxy (litellm_config.yaml) -----------------------
OPENAI_PROVIDER_API_KEY=
GOOGLE_LLM_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
CEREBRAS_API_KEY=
